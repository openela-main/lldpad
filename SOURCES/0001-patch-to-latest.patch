 		goto out_err;
 	}
+
+	/* May return NULL if CONFIG_ETHTOOL_NETLINK is disabled,
+	 * which isn't fatal
+	 */
+	ud->ethtool_sk = ethtool_sock_create();
+	if (!ud->ethtool_sk)
+		LLDPAD_WARN("Failed to create ethtool netlink socket\n");
+
 	LIST_INIT(&ud->head);
  	mod->id = LLDP_MOD_8023;
 	mod->ops = &ieee8023_ops;
